rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profil fotoğrafları: herkes okuyabilir, sadece sahibi yazabilir.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Gönderi görselleri: herkes okuyabilir, sadece sahibi yazabilir.
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Varsayılan: kapalı
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
