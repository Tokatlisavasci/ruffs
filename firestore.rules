rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Kullanıcı profilleri: herkes okuyabilir (profil/username/avatar gösterimi),
    // sadece sahibi oluşturabilir/güncelleyebilir.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        // temel alan kısıtlaması (isteğe göre genişletin)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(
          ['username','displayName','bio','avatar','email','followers','following','likes','createdAt','photoURL']
        );
      allow delete: if false;
    }

    // Gönderiler: herkes okuyabilir (ana sayfa), sadece sahibi yazar/siler.
    match /videos/{videoId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Beğeniler: okuma sadece sahibi (beğendiklerim listesi), yazma sunucu (admin) üzerinden.
    match /likes/{likeId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // İzlenmeler: tekilleştirme sunucuda; istemci okumaz/yazmaz.
    match /views/{viewId} {
      allow read, create, update, delete: if false;
    }

    // Kaydedilenler: okuma sadece sahibi, yazma sunucu (admin) üzerinden.
    match /saves/{saveId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Varsayılan: kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
