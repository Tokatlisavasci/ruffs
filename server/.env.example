PORT=4000

# Cloudinary (video yükleme için imzalı upload)
# Cloudinary Dashboard > Settings > API Keys bölümünden alın.
# CLOUDINARY_API_SECRET değerini ASLA uygulamaya/commit'e koymayın; sadece server/.env içinde tutun.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (İsteğe bağlı) Videoların yükleneceği klasör
CLOUDINARY_FOLDER=ruffs/videos
