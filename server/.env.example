# Render/Loops API ortam değişkenleri
# Bunları Render servis ayarlarına (Environment) ekleyin; .env dosyasını commit etmeyin.
PORT=4000
REQUIRE_AUTH=true

# Loops.video (tek hesap)
LOOPS_BASE_URL=https://loops.video
LOOPS_ACCESS_TOKEN=

# Firebase Admin (sunucu tarafı doğrulama/sayaç işlemleri)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
